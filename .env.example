# GitHub personal access token (needs repo + project read scope) used to auth to the hosted GitHub MCP server
GITHUB_TOKEN=

# Optional: override the hosted GitHub MCP endpoint
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# Default owner/repo used when not derivable from a project-board URL
GITHUB_OWNER=Bhushanbn
GITHUB_REPO=GitRepo_Acceptance-Criteria

# Status/label value that marks an issue ready for QA (matched against issue labels;
# the hosted GitHub MCP server doesn't expose Projects-v2 Status fields)
GITHUB_RFQA_STATUS=Ready for QA

# Project board number, kept for reference / a future local github-mcp-server with the
# "projects" toolset enabled — not currently used by githubClient.ts
GITHUB_PROJECT_NUMBER=2

# Real-time webhook trigger (GitHub App "projects_v2_item" events)
GITHUB_WEBHOOK_SECRET=
WEBHOOK_PORT=4000

# Target web app under test
APP_BASE_URL=https://www.saucedemo.com
